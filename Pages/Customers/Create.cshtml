@page
@model WebApplication1.Pages.Customers.CreateModel

@{
    ViewData["Title"] = "Add Customer";
}

<h1>Add New Customer</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Company Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Customer.CompanyName" class="form-label"></label>
                        <span class="text-danger">*</span>
                        <input asp-for="Customer.CompanyName" class="form-control" />
                        <span asp-validation-for="Customer.CompanyName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Customer.Address" class="form-label"></label>
                            <input asp-for="Customer.Address" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Customer.City" class="form-label"></label>
                            <input asp-for="Customer.City" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Customer.State" class="form-label"></label>
                            <input asp-for="Customer.State" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Customer.PostalCode" class="form-label"></label>
                            <input asp-for="Customer.PostalCode" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Customer.Country" class="form-label"></label>
                            <input asp-for="Customer.Country" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Primary Contact</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Customer.PrimaryContactName" class="form-label"></label>
                        <input asp-for="Customer.PrimaryContactName" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Customer.PrimaryEmail" class="form-label"></label>
                            <input asp-for="Customer.PrimaryEmail" type="email" class="form-control" />
                            <span asp-validation-for="Customer.PrimaryEmail" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Customer.PrimaryPhone" class="form-label"></label>
                            <input asp-for="Customer.PrimaryPhone" type="tel" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">Escalation Contact</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Customer.EscalationContactName" class="form-label"></label>
                        <input asp-for="Customer.EscalationContactName" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Customer.EscalationEmail" class="form-label"></label>
                            <input asp-for="Customer.EscalationEmail" type="email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Customer.EscalationPhone" class="form-label"></label>
                            <input asp-for="Customer.EscalationPhone" type="tel" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Account Management</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Customer.AccountManager" class="form-label"></label>
                            <input asp-for="Customer.AccountManager" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Customer.HourlyRate" class="form-label"></label>
                            <input asp-for="Customer.HourlyRate" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Customer.HourlyRate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.Notes" class="form-label"></label>
                        <textarea asp-for="Customer.Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-check">
                        <input asp-for="Customer.IsActive" class="form-check-input" />
                        <label asp-for="Customer.IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create Customer</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}