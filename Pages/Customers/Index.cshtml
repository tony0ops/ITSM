@page
@model WebApplication1.Pages.Customers.IndexModel

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customers</h1>
    @if (User.IsInRole("Manager"))
    {
        <a asp-page="Create" class="btn btn-primary">Add Customer</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" name="SearchTerm" value="@Model.SearchTerm"
               placeholder="Search by company, contact, email..." />
    </div>
    <div class="col-md-2">
        <select class="form-select" name="StatusFilter">
            <option value="">All Status</option>
            <option value="active"   selected="@(Model.StatusFilter == "active")">Active</option>
            <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Customers.Any())
{
    <div class="alert alert-info">
        No customers found.
        @if (User.IsInRole("Manager"))
        {
            <a asp-page="Create">Add a customer</a> @:to get started.
        }
    </div>
}
else
{
    <p class="text-muted small mb-2">Showing @Model.Customers.Count customer(s)</p>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Company Name</th>
                    <th>Primary Contact</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Account Manager</th>
                    <th>Hourly Rate</th>
                    <th>Status</th>
                    <th>Tickets</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    var statusDotStyle = $"background-color:{(customer.IsActive ? "#198754" : "#6c757d")};";
                    var statusText     = customer.IsActive ? "Active" : "Inactive";
                    var ticketCount    = customer.Tickets.Count;

                    <tr class="@(!customer.IsActive ? "table-secondary opacity-75" : "")">
                        <td>
                            <a asp-page="./Details" asp-route-id="@customer.Id" class="fw-semibold text-decoration-none">
                                @customer.CompanyName
                            </a>
                        </td>
                        <td><small>@(customer.PrimaryContactName ?? "-")</small></td>
                        <td>
                            <small>
                                @if (!string.IsNullOrEmpty(customer.PrimaryEmail))
                                { <a href="mailto:@customer.PrimaryEmail">@customer.PrimaryEmail</a> }
                                else
                                { <span class="text-muted">-</span> }
                            </small>
                        </td>
                        <td><small class="text-muted">@(customer.PrimaryPhone ?? "-")</small></td>
                        <td><small class="text-muted">@(customer.AccountManager ?? "-")</small></td>
                        <td><small>@customer.HourlyRate.ToString("C")</small></td>
                        <td>
                            <span class="status-dot status-dot-sm me-1" style="@statusDotStyle"></span>
                            <small>@statusText</small>
                        </td>
                        <td>
                            <small class="fw-semibold">@ticketCount</small>
                        </td>
                        <td class="text-nowrap">
                            @if (User.IsInRole("Manager"))
                            {
                                <a asp-page="./Edit" asp-route-id="@customer.Id" class="text-primary text-decoration-none">Edit</a>
                                <span class="text-muted mx-1">|</span>
                                <a asp-page="./Details" asp-route-id="@customer.Id" class="text-secondary text-decoration-none">Details</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}