@page
@model WebApplication1.Pages.Customers.IndexModel

@{
    ViewData["Title"] = "Customers";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customers</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Customer
    </a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" name="search" value="@Model.SearchTerm" 
               placeholder="Search by company, contact, email..." />
    </div>
    <div class="col-md-2">
        <select class="form-select" name="status">
            <option value="">All Status</option>
            <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
            <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
        </select>
    </div>
    <div class="col-md-1">
        <button class="btn btn-primary w-100" type="submit">Filter</button>
    </div>
</form>

@if (!Model.Customers.Any())
{
    <div class="alert alert-info">
        <strong>No customers found.</strong> Click "Add Customer" to create one.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Company Name</th>
                    <th>Primary Contact</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Account Manager</th>
                    <th>Hourly Rate</th>
                    <th>Status</th>
                    <th>Tickets</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td>
                            <a asp-page="./Details" asp-route-id="@customer.Id" class="fw-bold">
                                @customer.CompanyName
                            </a>
                        </td>
                        <td>@(customer.PrimaryContactName ?? "-")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(customer.PrimaryEmail))
                            {
                                <a href="mailto:@customer.PrimaryEmail">@customer.PrimaryEmail</a>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td>@(customer.PrimaryPhone ?? "-")</td>
                        <td>@(customer.AccountManager ?? "-")</td>
                        <td>@customer.HourlyRate.ToString("C")</td>
                        <td>
                            @if (customer.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-primary">@customer.Tickets.Count</span>
                        </td>
                        <td>
                            <a asp-page="./Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-page="./Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-info">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <p class="text-muted">Total: @Model.Customers.Count customer(s)</p>
</div>