@page
@model WebApplication1.Pages.Customers.DetailsModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Customer Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customer Details</h1>
    <div>
        @if (User.IsInRole("Manager"))
        {
            <a asp-page="./Edit" asp-route-id="@Model.Customer.Id" class="btn btn-primary">Edit</a>
            <a asp-page="./ManageSla" asp-route-id="@Model.Customer.Id" class="btn btn-outline-info">Manage SLA</a>
        }
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">@Model.Customer.CompanyName</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@(Model.Customer.IsActive ? "Active" : "Inactive")</dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.Customer.CreatedAt.ToString("M/d/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Customer.Address))
                        {
                            <text>@Model.Customer.Address</text>
                            <br />
                            <text>@Model.Customer.City, @Model.Customer.State @Model.Customer.PostalCode</text>
                            <br />
                            <text>@Model.Customer.Country</text>
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Contacts</h5>
            </div>
            <div class="card-body">
                <h6>Primary Contact</h6>
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@(Model.Customer.PrimaryContactName ?? "-")</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Customer.PrimaryEmail))
                        {
                            <a href="mailto:@Model.Customer.PrimaryEmail">@Model.Customer.PrimaryEmail</a>
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(Model.Customer.PrimaryPhone ?? "-")</dd>
                </dl>
                <hr />
                <h6>Escalation Contact</h6>
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@(Model.Customer.EscalationContactName ?? "-")</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Customer.EscalationEmail))
                        {
                            <a href="mailto:@Model.Customer.EscalationEmail">@Model.Customer.EscalationEmail</a>
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(Model.Customer.EscalationPhone ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Account Management</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Account Manager</dt>
                    <dd class="col-sm-7">@(Model.Customer.AccountManager ?? "-")</dd>

                    <dt class="col-sm-5">Hourly Rate</dt>
                    <dd class="col-sm-7">@Model.Customer.HourlyRate.ToString("C")</dd>

                    <dt class="col-sm-5">Total Hours Billed</dt>
                    <dd class="col-sm-7">@Model.TotalHoursBilled.ToString("F2") hrs</dd>

                    <dt class="col-sm-5">Total Revenue</dt>
                    <dd class="col-sm-7"><strong>@Model.TotalRevenue.ToString("C")</strong></dd>

                    <dt class="col-sm-5">Notes</dt>
                    <dd class="col-sm-7">@(Model.Customer.Notes ?? "-")</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Ticket Statistics</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Total Tickets</dt>
                    <dd class="col-sm-7">@Model.TicketRows.Count</dd>

                    <dt class="col-sm-5">Open Tickets</dt>
                    <dd class="col-sm-7">@Model.TicketRows.Count(t => !TicketHelper.IsClosedLike(t.Status))</dd>

                    <dt class="col-sm-5">Closed Tickets</dt>
                    <dd class="col-sm-7">@Model.TicketRows.Count(t => TicketHelper.IsClosedLike(t.Status))</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Portal Users - Managers only -->
@if (User.IsInRole("Manager"))
{
    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Portal Users (@Model.PortalUsers.Count)</h5>
            <button class="btn btn-sm btn-success" type="button"
                    data-bs-toggle="collapse" data-bs-target="#addPortalUserPanel">
                + Add Portal User
            </button>
        </div>
        <div class="card-body">
            <div class="alert alert-info small mb-3">
                Portal users are customer contacts who can log in to view tickets and post comments.
                Create one account per contact person and share the credentials directly - no email required.
            </div>

            <div class="collapse mb-4" id="addPortalUserPanel">
                <div class="card card-body bg-light">
                    <h6 class="mb-3">New Portal User</h6>
                    <form method="post" asp-page-handler="CreatePortalUser" asp-route-id="@Model.Customer.Id">
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label">Email (used to log in)</label>
                                <input asp-for="NewPortalEmail" type="email" class="form-control"
                                       required placeholder="contact@company.com" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Password</label>
                                <input asp-for="NewPortalPassword" type="text" class="form-control"
                                       placeholder="Min 6 chars, 1 digit, 1 uppercase" />
                                <div class="form-text">Required for new accounts. Leave blank to link an existing user.</div>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-auto">
                                <div class="form-check">
                                    <input type="checkbox" asp-for="NewCanViewTickets"
                                           class="form-check-input" id="chkView" />
                                    <label class="form-check-label" for="chkView">Can View Tickets</label>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="form-check">
                                    <input type="checkbox" asp-for="NewCanAddComments"
                                           class="form-check-input" id="chkComment" />
                                    <label class="form-check-label" for="chkComment">Can Add Comments</label>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="form-check">
                                    <input type="checkbox" asp-for="NewCanCreateTickets"
                                           class="form-check-input" id="chkCreate" />
                                    <label class="form-check-label" for="chkCreate">Can Create Tickets</label>
                                </div>
                            </div>
                            <div class="col-12 form-text">Ticket creation also requires Can View Tickets.</div>
                        </div>
                        <button type="submit" class="btn btn-success btn-sm">Create & Link User</button>
                        <button type="button" class="btn btn-secondary btn-sm"
                                data-bs-toggle="collapse" data-bs-target="#addPortalUserPanel">
                            Cancel
                        </button>
                    </form>
                </div>
            </div>

            @if (Model.PortalUsers.Any())
            {
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Can View</th>
                            <th>Can Comment</th>
                            <th>Can Create</th>
                            <th>Status</th>
                            <th>Added</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pu in Model.PortalUsers)
                        {
                            var dotColor = pu.IsActive ? "#198754" : "#6c757d";
                            var dotStyle = $"background-color:{dotColor};";
                            <tr class="@(!pu.IsActive ? "table-secondary opacity-75" : "")">
                                <td><small>@pu.Email</small></td>
                                <td><input type="checkbox" name="canViewTickets" value="true" checked="@pu.CanViewTickets"
                                    form="permissions-@pu.CustomerUserId" aria-label="Allow @pu.Email to view tickets" /></td>
                                <td><input type="checkbox" name="canAddComments" value="true" checked="@pu.CanAddComments"
                                    form="permissions-@pu.CustomerUserId" aria-label="Allow @pu.Email to add comments" /></td>
                                <td class="text-nowrap">
                                    <input type="checkbox" name="canCreateTickets" value="true" checked="@pu.CanCreateTickets"
                                           form="permissions-@pu.CustomerUserId" aria-label="Allow @pu.Email to create tickets" />
                                </td>
                                <td>
                                    <span class="status-dot status-dot-sm me-1" style="@dotStyle"></span>
                                    <small>@(pu.IsActive ? "Active" : "Inactive")</small>
                                </td>
                                <td><small class="text-muted">@pu.CreatedAt.ToString("M/d/yyyy")</small></td>
                                <td class="text-nowrap">
                                    <form id="permissions-@pu.CustomerUserId" method="post" asp-page-handler="UpdatePermissions"
                                          asp-route-id="@Model.Customer.Id" asp-route-customerUserId="@pu.CustomerUserId" class="d-inline">
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Save permissions</button>
                                    </form>
                                    <form method="post" asp-page-handler="TogglePortalUser"
                                          asp-route-id="@Model.Customer.Id"
                                          asp-route-customerUserId="@pu.CustomerUserId"
                                          class="d-inline"
                                          onsubmit="return confirm('Change this portal account activation status?')">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            @(pu.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="RemovePortalUser"
                                          asp-route-id="@Model.Customer.Id"
                                          asp-route-customerUserId="@pu.CustomerUserId"
                                          class="d-inline"
                                          onsubmit="return confirm('Unlink this portal account? They will lose access.')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Unlink</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No portal users yet. Add one to let customer contacts log in and view tickets.</p>
            }
        </div>
    </div>
}

<!-- Tickets List -->
<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Tickets (@Model.TicketRows.Count)</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <input type="hidden" name="id" value="@Model.Customer.Id" />
            <div class="col-auto">
                <select name="TicketSort" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="updated_desc" selected="@(Model.TicketSort == "updated_desc")">Last Updated ↓</option>
                    <option value="updated_asc"  selected="@(Model.TicketSort == "updated_asc")">Last Updated ↑</option>
                    <option value="created_desc" selected="@(Model.TicketSort == "created_desc")">Created ↓</option>
                    <option value="created_asc"  selected="@(Model.TicketSort == "created_asc")">Created ↑</option>
                    <option value="status"       selected="@(Model.TicketSort == "status")">Status</option>
                    <option value="severity"     selected="@(Model.TicketSort == "severity")">Severity</option>
                </select>
            </div>
            <div class="col-auto">
                <select name="TicketStatus" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<TicketStatus>())
                    {
                        <option value="@s" selected="@(Model.TicketStatus == s)">@s</option>
                    }
                </select>
            </div>
            @if (Model.TicketStatus.HasValue || Model.TicketSort != "updated_desc")
            {
                <div class="col-auto">
                    <a asp-page="./Details" asp-route-id="@Model.Customer.Id"
                       class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            }
        </form>

        @if (!Model.TicketRows.Any())
        {
            <p class="text-muted">No tickets found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:100px;">Number</th>
                            <th>Title</th>
                            <th style="width:90px;">Severity</th>
                            <th style="width:110px;">Status</th>
                            <th style="width:115px;">Created</th>
                            <th style="width:115px;">Last Update</th>
                            <th>Latest Note</th>
                            <th style="width:60px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.TicketRows)
                        {
                            var isClosed    = TicketHelper.IsClosedLike(t.Status);
                            var sevDotStyle = $"background-color:{TicketHelper.GetSeverityDotColor(t.Severity)};";
                            var hasNote     = !string.IsNullOrEmpty(t.LastUpdateNote);

                            <tr class="@(isClosed ? "table-secondary opacity-75" : "")">
                                <td class="text-nowrap">
                                    <a asp-page="/Tickets/Details" asp-route-id="@t.Id">
                                        <small>@t.Number</small>
                                    </a>
                                </td>
                                <td style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                    title="@t.Title">
                                    <small>@t.Title</small>
                                </td>
                                <td>
                                    <span class="status-dot status-dot-sm me-1" style="@sevDotStyle"></span>
                                    <small>@t.Severity</small>
                                </td>
                                <td><small>@t.Status</small></td>
                                <td class="text-nowrap">
                                    <small class="text-muted">@t.CreatedAt.ToString("M/d/yyyy HH:mm")</small>
                                </td>
                                <td class="text-nowrap">
                                    <small class="@(hasNote ? "text-success fw-semibold" : "text-muted")">
                                        @t.LastUpdated.ToString("M/d/yyyy HH:mm")
                                    </small>
                                </td>
                                <td style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                    title="@t.LastUpdateNote">
                                    @if (hasNote)
                                    {
                                        <small class="text-muted fst-italic">@t.LastUpdateNote</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">-</small>
                                    }
                                </td>
                                <td>
                                    <a asp-page="/Tickets/Details" asp-route-id="@t.Id"
                                       class="text-secondary text-decoration-none">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
