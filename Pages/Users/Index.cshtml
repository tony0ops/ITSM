@page
@model WebApplication1.Pages.Users.IndexModel

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Users</h1>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" name="SearchTerm" value="@Model.SearchTerm"
               placeholder="Search by email, name, team, or role..." />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Users.Any())
{
    <div class="alert alert-info">
        No users found.
    </div>
}
else
{
    <p class="text-muted small mb-2">Showing @Model.Users.Count user(s)</p>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Display Name</th>
                    <th>Department</th>
                    <th>Job Title</th>
                    <th>Role</th>
                    <th>Team</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var roleDot = user.Role switch
                    {
                        "Manager" => "#dc3545",
                        "Agent" => "#0d6efd",
                        _ => "#6c757d"
                    };

                    var statusDot = user.IsActive ? "#198754" : "#6c757d";
                    var statusText = user.IsActive ? "Active" : "Inactive";

                    <tr class="@(!user.IsActive ? "table-secondary opacity-75" : "")">
                        <td><small>@user.Email</small></td>
                        <td><small>@user.DisplayName</small></td>
                        <td><small class="text-muted">@(user.Department ?? "-")</small></td>
                        <td><small class="text-muted">@(user.JobTitle ?? "-")</small></td>
                        <td>
                            <span class="status-dot status-dot-sm me-1" style="background:@roleDot;"></span>
                            <small>@user.Role</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(user.TeamName))
                            { <small>@user.TeamName</small> }
                            else
                            { <small class="text-muted">-</small> }
                        </td>
                        <td>
                            <span class="status-dot status-dot-sm me-1" style="background:@statusDot;"></span>
                            <small>@statusText</small>
                        </td>
                        <td class="text-nowrap">
                            <a asp-page="./Edit" asp-route-id="@user.UserId" class="text-primary text-decoration-none">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}