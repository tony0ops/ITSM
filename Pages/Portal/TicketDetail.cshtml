@page
@model WebApplication1.Pages.Portal.TicketDetailModel
@using WebApplication1.Models

@{
    ViewData["Title"] = $"Ticket {Model.Ticket.Number}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Ticket.Number - @Model.Ticket.Title</h1>
    <a asp-page="./MyTickets" class="btn btn-secondary">Back to My Tickets</a>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Ticket Details -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Ticket Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-@(Model.Ticket.Status switch {
                            TicketStatus.New => "primary",
                            TicketStatus.Assigned => "info text-dark",
                            TicketStatus.InProgress => "warning text-dark",
                            TicketStatus.WaitingOnCustomer => "secondary",
                            TicketStatus.WaitingOnVendor => "secondary",
                            TicketStatus.Resolved => "success",
                            TicketStatus.Closed => "dark",
                            TicketStatus.Cancelled => "danger",
                            _ => "secondary"
                        })">@Model.Ticket.Status</span>
                    </dd>

                    <dt class="col-sm-3">Severity</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-@(Model.Ticket.Severity switch {
                            Severity.Critical => "danger",
                            Severity.High => "warning text-dark",
                            Severity.Medium => "primary",
                            Severity.Low => "info text-dark",
                            Severity.Info => "secondary",
                            _ => "secondary"
                        })">@Model.Ticket.Severity</span>
                    </dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary">
                            @Model.Ticket.Category.ToString().Replace("GeneralRequest", "General")
                        </span>
                    </dd>

                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9">@Model.Ticket.CreatedAt.ToString("g")</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Ticket.Description</dd>
                </dl>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Communication (@Model.VisibleComments.Count)</h5>
            </div>
            <div class="card-body">
                @if (Model.VisibleComments.Count == 0)
                {
                    <div class="alert alert-info">
                        <strong>No updates yet.</strong> We will notify you when there are updates to your ticket.
                    </div>
                }
                else
                {
                    <div class="list-group mb-4">
                        @foreach (var comment in Model.VisibleComments)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="mb-1">
                                            <strong>@comment.UserName</strong>
                                            <span class="badge bg-secondary">@comment.UserRole</span>
                                        </h6>
                                    </div>
                                    <small class="text-muted">@comment.CreatedAt.ToString("M/d/yyyy HH:mm")</small>
                                </div>
                                <p class="mb-0 text-break">@comment.Comment</p>
                            </div>
                        }
                    </div>
                }

                <!-- Add Comment Form -->
                <hr />
                <h6>Add a Comment</h6>
                <form method="post" asp-page-handler="AddComment" asp-route-id="@Model.Ticket.Id">
                    <div class="mb-3">
                        <textarea asp-for="NewComment" class="form-control" rows="3" 
                                  placeholder="Share your feedback or ask a question..." required></textarea>
                        <span asp-validation-for="NewComment" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Sidebar Info -->
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Timeline</h6>
            </div>
            <div class="card-body small">
                <dl>
                    <dt>Submitted</dt>
                    <dd>@Model.Ticket.CreatedAt.ToString("g")</dd>

                    @if (Model.Ticket.ResolvedAt.HasValue)
                    {
                        <dt>Resolved</dt>
                        <dd>@Model.Ticket.ResolvedAt.Value.ToString("g")</dd>
                    }

                    @if (Model.Ticket.ClosedAt.HasValue)
                    {
                        <dt>Closed</dt>
                        <dd>@Model.Ticket.ClosedAt.Value.ToString("g")</dd>
                    }
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Ticket.ResolutionNotes))
        {
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">Resolution</h6>
                </div>
                <div class="card-body small">
                    <p>@Model.Ticket.ResolutionNotes</p>
                </div>
            </div>
        }
    </div>
</div>