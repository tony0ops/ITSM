@page
@model WebApplication1.Pages.Portal.MyTicketsModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "My Tickets";
}

<h1>My Support Tickets</h1>
<p class="text-muted">Welcome back, @Model.CustomerName</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card border-primary h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Tickets</h6>
                @* Use TotalTicketsCount so Cancelled tickets are not excluded *@
                <p class="h3 mb-0">@Model.TotalTicketsCount</p>
                <small class="text-muted">All time</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-warning h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Open Tickets</h6>
                <p class="h3 mb-0 text-warning">@Model.OpenTicketsCount</p>
                <small class="text-muted">In progress</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-success h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Closed / Resolved</h6>
                <p class="h3 mb-0 text-success">@Model.ClosedTicketsCount</p>
                <small class="text-muted">Completed</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-info h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Comments</h6>
                <p class="h3 mb-0">@Model.TotalComments</p>
                <small class="text-muted">Visible updates</small>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" name="SearchTerm" value="@Model.SearchTerm"
               placeholder="Search by number or title..." />
    </div>
    <div class="col-md-2">
        <select class="form-select" name="StatusFilter">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<TicketStatus>())
            {
                <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" name="SortBy">
            <option value="updated_desc" selected="@(Model.SortBy == "updated_desc")">Last Updated ↓</option>
            <option value="updated_asc" selected="@(Model.SortBy == "updated_asc")">Last Updated ↑</option>
            <option value="created_desc" selected="@(Model.SortBy == "created_desc")">Created ↓</option>
            <option value="created_asc" selected="@(Model.SortBy == "created_asc")">Created ↑</option>
            <option value="status" selected="@(Model.SortBy == "status")">Status</option>
            <option value="severity" selected="@(Model.SortBy == "severity")">Severity</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
    @if (Model.StatusFilter.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SortBy != "updated_desc")
    {
        <div class="col-auto">
            <a asp-page="./MyTickets" class="btn btn-outline-secondary">Clear</a>
        </div>
    }
</form>

<!-- Ticket Table -->
@if (!Model.TicketRows.Any())
{
    <div class="alert alert-info">
        <strong>No tickets found.</strong>
        @if (Model.StatusFilter.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <text> Try adjusting your filters.</text>
        }
    </div>
}
else
{
    <p class="text-muted small mb-2">Showing @Model.TicketRows.Count ticket(s)</p>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:100px;">Number</th>
                    <th>Title</th>
                    <th style="width:90px;">Severity</th>
                    <th style="width:100px;">Status</th>
                    <th style="width:100px;">Created</th>
                    <th style="width:115px;">Last Update</th>
                    <th>Latest Note</th>
                    <th style="width:60px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.TicketRows)
                {
                    var isClosed    = TicketHelper.IsClosedLike(t.Status);
                    var sevDotStyle = $"background-color:{TicketHelper.GetSeverityDotColor(t.Severity)};";
                    var hasNote     = !string.IsNullOrEmpty(t.LastUpdateNote);

                    <tr class="@(isClosed ? "table-secondary opacity-75" : "")">
                        <td class="text-nowrap">
                            <a asp-page="./TicketDetail" asp-route-id="@t.Id">
                                <small>@t.Number</small>
                            </a>
                        </td>
                        <td style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                            title="@t.Title">
                            <small>@t.Title</small>
                        </td>
                        <td>
                            <span class="status-dot status-dot-sm me-1" style="@sevDotStyle"></span>
                            <small>@t.Severity</small>
                        </td>
                        <td><small>@t.Status</small></td>
                        <td class="text-nowrap">
                            <small class="text-muted">@t.CreatedAt.ToString("M/d/yyyy")</small>
                        </td>
                        <td class="text-nowrap">
                            <small class="@(hasNote ? "text-success fw-semibold" : "text-muted")">
                                @t.LastUpdated.ToString("M/d/yyyy HH:mm")
                            </small>
                        </td>
                        <td style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                            title="@t.LastUpdateNote">
                            @if (hasNote)
                            {
                                <small class="text-muted fst-italic">@t.LastUpdateNote</small>
                            }
                            else
                            {
                                <small class="text-muted">-</small>
                            }
                        </td>
                        <td>
                            <a asp-page="./TicketDetail" asp-route-id="@t.Id"
                               class="text-secondary text-decoration-none">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}