@page
@model WebApplication1.Pages.Portal.MyTicketsModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "My Tickets";
}

<h1>My Support Tickets</h1>
<p class="text-muted">Welcome back, @Model.CustomerName</p>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card border-primary h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Tickets</h6>
                <p class="h3 mb-0">@(Model.MyTickets.Count + Model.ResolvedTicketsCount)</p>
                <small class="text-muted">All time</small>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-warning h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Open Tickets</h6>
                <p class="h3 mb-0 text-warning">@Model.OpenTicketsCount</p>
                <small class="text-muted">In progress</small>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-success h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Resolved</h6>
                <p class="h3 mb-0 text-success">@Model.ResolvedTicketsCount</p>
                <small class="text-muted">Completed</small>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-info h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Comments</h6>
                <p class="h3 mb-0">
                    @Model.MyTickets
                        .SelectMany(t => t.Comments)
                        .Count(c => c.IsCustomerVisible && !c.IsInternal)
                </p>
                <small class="text-muted">Visible updates</small>
            </div>
        </div>
    </div>
</div>

<!-- Search and Filter -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input class="form-control" name="searchTerm" value="@Model.SearchTerm"
                       placeholder="Search by ticket number or title..." />
            </div>
            <div class="col-md-3">
                <select class="form-select" name="statusFilter">
                    <option value="">All Statuses</option>
                    @foreach (var status in Enum.GetValues<TicketStatus>())
                    {
                        <option value="@status" selected="@(Model.StatusFilter == status)">
                            @status.ToString().Replace("WaitingOn", "Waiting on ")
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Tickets List -->
@if (Model.MyTickets.Count == 0)
{
    <div class="alert alert-info">
        <strong>No tickets found.</strong>
        @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue)
        {
            <text>Try adjusting your filters.</text>
        }
    </div>
}
else
{
    <div class="row">
        @foreach (var ticket in Model.MyTickets)
        {
            var now = DateTime.Now;
            var slaState = SlaPolicy.GetState(ticket, now);
            var remaining = SlaPolicy.FormatRemaining(ticket, now);
            var visibleComments = Model.GetVisibleComments(ticket.Id);

            var statusDot = ticket.Status switch
            {
                TicketStatus.New => "#0d6efd",
                TicketStatus.Assigned => "#0dcaf0",
                TicketStatus.InProgress => "#ffc107",
                TicketStatus.WaitingOnCustomer => "#6c757d",
                TicketStatus.WaitingOnVendor => "#6c757d",
                TicketStatus.Resolved => "#198754",
                TicketStatus.Closed => "#343a40",
                TicketStatus.Cancelled => "#dc3545",
                _ => "#6c757d"
            };

            var sevDot = ticket.Severity switch
            {
                Severity.Critical => "#dc3545",
                Severity.High => "#fd7e14",
                Severity.Medium => "#0d6efd",
                Severity.Low => "#0dcaf0",
                Severity.Info => "#6c757d",
                _ => "#6c757d"
            };

            var slaBadge = SlaPolicy.GetBadgeClass(slaState);

            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-title mb-1 fw-semibold">@ticket.Number</h6>
                                <p class="card-text small text-muted mb-0">@ticket.Title</p>
                            </div>
                            <div>
                                <span class="status-dot status-dot-sm me-1" style="background:@statusDot;"></span>
                                <small>@ticket.Status</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <dl class="row small mb-2">
                            <dt class="col-sm-5 text-muted">Severity</dt>
                            <dd class="col-sm-7">
                                <span class="status-dot status-dot-sm me-1" style="background:@sevDot;"></span>
                                @ticket.Severity
                            </dd>

                            <dt class="col-sm-5 text-muted">Category</dt>
                            <dd class="col-sm-7">@ticket.Category</dd>

                            <dt class="col-sm-5 text-muted">Created</dt>
                            <dd class="col-sm-7">@ticket.CreatedAt.ToString("M/d/yyyy")</dd>

                            <dt class="col-sm-5 text-muted">SLA</dt>
                            <dd class="col-sm-7">
                                @if (SlaPolicy.IsSlaPaused(ticket.Status))
                                {
                                    <small class="text-muted">Paused</small>
                                }
                                else
                                {
                                    <small><span class="badge @slaBadge">@remaining</span></small>
                                }
                            </dd>
                        </dl>

                        @if (visibleComments.Any())
                        {
                            <div class="border rounded p-2 small bg-light">
                                <strong class="text-muted">Latest Update:</strong>
                                <p class="mb-0 text-truncate">@visibleComments.Last().Comment</p>
                                <small class="text-muted">@visibleComments.Last().CreatedAt.ToString("M/d HH:mm")</small>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-page="./TicketDetail" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}