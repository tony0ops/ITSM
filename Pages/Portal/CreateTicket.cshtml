@page
@model WebApplication1.Pages.Portal.CreateTicketModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Create Support Ticket";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Submit a Support Ticket</h1>
        <p class="text-muted mb-0">For @Model.CustomerName</p>
    </div>
    <a asp-page="./MyTickets" class="btn btn-outline-secondary">Back to My Tickets</a>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label"></label>
                        <input asp-for="Input.Title" class="form-control" maxlength="120" required />
                        <span asp-validation-for="Input.Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="6" maxlength="4000" required></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Category" class="form-label"></label>
                            <select asp-for="Input.Category" class="form-select"
                                    asp-items="Html.GetEnumSelectList<TicketCategory>()"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Severity" class="form-label"></label>
                            <select asp-for="Input.Severity" class="form-select"
                                    asp-items="Html.GetEnumSelectList<Severity>()"></select>
                        </div>
                    </div>
                    <div class="alert alert-info small">
                        Your ticket will be linked to @Model.CustomerName and start in New status.
                    </div>
                    <button type="submit" class="btn btn-primary">Submit Ticket</button>
                    <a asp-page="./MyTickets" class="btn btn-outline-secondary ms-1">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
