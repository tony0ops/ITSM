@model List<WebApplication1.Models.Ticket>
@using WebApplication1.Models

@if (Model?.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No tickets in this category.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:100px;">Number</th>
                    <th style="width:250px;">Title</th>
                    <th style="width:90px;">Category</th>
                    <th style="width:80px;">Severity</th>
                    <th style="width:100px;">Status</th>
                    <th style="width:120px;">Customer</th>
                    <th style="width:100px;">SLA Due</th>
                    <th style="width:90px;">SLA</th>
                    <th style="width:100px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var ticket in Model)
                    {
                        var now = DateTime.Now;
                        var slaState = SlaPolicy.GetState(ticket, now);
                        var remaining = SlaPolicy.FormatRemaining(ticket, now);

                        var isClosed = ticket.Status == TicketStatus.Closed ||
                                       ticket.Status == TicketStatus.Resolved ||
                                       ticket.Status == TicketStatus.Cancelled;

                        var slaBadge = slaState switch
                        {
                            SlaState.Green => "bg-success",
                            SlaState.Yellow => "bg-warning text-dark",
                            SlaState.Red => "bg-danger",
                            SlaState.Breached => "bg-dark",
                            _ => "bg-secondary"
                        };

                        var severityClass = ticket.Severity switch
                        {
                            Severity.Critical => "text-danger fw-semibold",
                            Severity.High => "text-warning fw-semibold",
                            _ => ""
                        };

                        <tr class="@(isClosed ? "table-secondary opacity-75" : "")">
                            <td>
                                <a asp-page="/Tickets/Details" asp-route-id="@ticket.Id"><strong>@ticket.Number</strong></a>
                            </td>
                            <td style="max-width:250px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@ticket.Title">
                                @ticket.Title
                            </td>
                            <td><small>@ticket.Category.ToString().Replace("GeneralRequest", "General")</small></td>
                            <td><small class="@severityClass">@ticket.Severity</small></td>
                            <td><small>@ticket.Status.ToString().Replace("WaitingOnCustomer", "Wait: Cust").Replace("WaitingOnVendor", "Wait: Vendor")</small></td>
                            <td style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                <small>
                                    @if (ticket.Customer != null)
                                    { @ticket.Customer.CompanyName }
                                    else
                                    { <span class="text-muted">-</span> }
                                </small>
                            </td>
                            <td class="text-nowrap">
                                <small>@(ticket.SlaDueAt?.ToString("M/d HH:mm") ?? "N/A")</small>
                            </td>
                            <td>
                                @if (isClosed)
                                { <small class="text-muted">Closed</small> }
                                else if (SlaPolicy.IsSlaPaused(ticket.Status))
                                { <small class="text-info">Paused</small> }
                                else
                                { <small><span class="badge @slaBadge">@remaining</span></small> }
                            </td>
                            <td class="text-nowrap">
                                <a asp-page="/Tickets/Edit" asp-route-id="@ticket.Id" class="text-primary text-decoration-none">Update</a>
                                <span class="text-muted mx-1">|</span>
                                <a asp-page="/Tickets/Details" asp-route-id="@ticket.Id" class="text-secondary text-decoration-none">Details</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}