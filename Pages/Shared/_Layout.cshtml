@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITSM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-primary" asp-page="/Dashboard/Index">ITSM</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark text-decoration-none text-nowrap" asp-page="/Dashboard/Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark text-decoration-none text-nowrap" asp-page="/Tickets/Index">All Tickets</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark text-decoration-none text-nowrap" asp-page="/Tickets/NewQueue">Unassigned Tickets</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark text-decoration-none text-nowrap" asp-page="/MyTickets/Index">My Tickets</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark text-decoration-none text-nowrap" asp-page="/Tickets/MyGroupQueue">Team Queue</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark text-decoration-none text-nowrap" asp-page="/Customers/Index">Customers</a>
                            </li>
                            @if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark text-decoration-none text-nowrap" asp-page="/Users/Index">Users</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark text-decoration-none text-nowrap" asp-page="/Teams/Index">Teams</a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav flex-grow-1"></ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid px-4">
            &copy; 2026 - ITSM
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>