@page
@model WebApplication1.Pages.Tickets.DetailsModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Ticket Details";
}

<h1>Ticket Details</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h4 class="mb-0">@Model.Ticket.Number - @Model.Ticket.Title</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Ticket.Description</dd>

                    <dt class="col-sm-3">Severity</dt>
                    <dd class="col-sm-9">
                        @{
                            var sevClass = Model.Ticket.Severity switch
                            {
                                Severity.Critical => "text-danger fw-semibold",
                                Severity.High => "text-warning fw-semibold",
                                _ => ""
                            };
                        }
                        <span class="@sevClass">@Model.Ticket.Severity</span>
                    </dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@Model.Ticket.Status</dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">@Model.Ticket.Category</dd>

                    <dt class="col-sm-3">Assignment Group</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-info">@Model.Ticket.AssignedGroup.ToString().Replace("_", " ")</span>
                    </dd>

                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9">@Model.Ticket.CreatedAt.ToString("M/d/yyyy HH:mm")</dd>

                    <dt class="col-sm-3">SLA Due</dt>
                    <dd class="col-sm-9">
                        @if (Model.Ticket.SlaDueAt.HasValue)
                        {
                            var now = DateTime.Now;
                            var slaState = SlaPolicy.GetState(Model.Ticket, now);
                            var remaining = SlaPolicy.FormatRemaining(Model.Ticket, now);
                            var slaBadge = SlaPolicy.GetBadgeClass(slaState);
                            <span>@SlaPolicy.GetEffectiveDueAt(Model.Ticket, now).ToString("M/d/yyyy HH:mm")</span>
                            <span class="badge @slaBadge ms-2">@remaining</span>
                        }
                        else
                        {
                            <text>N/A</text>
                        }
                    </dd>

                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9">
                        @if (Model.Ticket.Customer != null)
                        {
                            @if (User.IsInRole("Manager"))
                            {
                                <a asp-page="/Customers/Details" asp-route-id="@Model.Ticket.Customer.Id">@Model.Ticket.Customer.CompanyName</a>
                            }
                            else
                            {
                                @Model.Ticket.Customer.CompanyName
                            }
                        }
                        else
                        {
                            @(Model.Ticket.CustomerName ?? "N/A")
                        }
                    </dd>

                    <dt class="col-sm-3">Assignee</dt>
                    <dd class="col-sm-9">@Model.AssigneeDisplayName</dd>

                    @if (Model.Ticket.ClosedAt.HasValue)
                    {
                        <dt class="col-sm-3">Closed</dt>
                        <dd class="col-sm-9">@Model.Ticket.ClosedAt.Value.ToString("M/d/yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>

        @if (Model.Ticket.SlaPausedAt.HasValue)
        {
            <div class="alert alert-info">
                <h6 class="mb-2">SLA Currently Paused</h6>
                <p class="mb-1"><strong>Paused Since:</strong> @Model.Ticket.SlaPausedAt.Value.ToString("M/d/yyyy HH:mm")</p>
                <p class="mb-1"><strong>Reason:</strong> @(Model.Ticket.PauseReason ?? "Not specified")</p>
                <p class="mb-0"><strong>Current Pause Duration:</strong> @SlaPolicy.FormatPausedDuration(DateTime.Now - Model.Ticket.SlaPausedAt.Value)</p>
            </div>
        }

        @if (Model.Ticket.TotalPausedDuration > TimeSpan.Zero)
        {
            <dl class="row">
                <dt class="col-sm-3">Total Time Paused</dt>
                <dd class="col-sm-9">@SlaPolicy.FormatPausedDuration(Model.Ticket.TotalPausedDuration)</dd>
            </dl>
        }

        @if (TicketHelper.IsClosedLike(Model.Ticket.Status))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Resolution Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        @if (Model.Ticket.ResolvedAt.HasValue)
                        {
                            <dt class="col-sm-3">Resolved At</dt>
                            <dd class="col-sm-9">@Model.Ticket.ResolvedAt.Value.ToString("M/d/yyyy HH:mm")</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Ticket.ResolutionNotes))
                        {
                            <dt class="col-sm-3">Resolution Notes</dt>
                            <dd class="col-sm-9">@Model.Ticket.ResolutionNotes</dd>
                        }
                        @if (Model.Ticket.ClosedAt.HasValue)
                        {
                            <dt class="col-sm-3">Closed At</dt>
                            <dd class="col-sm-9">@Model.Ticket.ClosedAt.Value.ToString("M/d/yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Time Tracking</h5>
            </div>
            <div class="card-body">
                <p class="h3 mb-1">@((int)Model.TotalTimeSpent.TotalHours)h @(Model.TotalTimeSpent.Minutes)m</p>
                <p class="text-muted">Total time spent</p>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#logTimeModal">
                    Log Time
                </button>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <a asp-page="./Edit" asp-route-id="@Model.Ticket.Id" class="btn btn-primary">Edit</a>
    @if (User.IsInRole("Manager"))
    {
        <a asp-page="./Delete" asp-route-id="@Model.Ticket.Id" class="btn btn-outline-danger">Delete</a>
    }
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>

<div class="card mt-4 mb-4">
    <div class="card-header"><h5 class="mb-0">Ticket-level attachments (@Model.Attachments.Count)</h5></div>
    <div class="card-body">
        @if (Model.Attachments.Count == 0)
        {
            <p class="text-muted">No standalone ticket attachments. New files are attached to replies below.</p>
        }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var attachment in Model.Attachments)
                {
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span>
                            <a asp-page-handler="DownloadAttachment" asp-route-id="@Model.Ticket.Id" asp-route-attachmentId="@attachment.Id">@attachment.FileName</a>
                            <small class="text-muted">(@((attachment.FileSize / 1024d).ToString("N0")) KB) · @attachment.UploadedByName · @attachment.CreatedAt.ToString("g")</small>
                            @if (attachment.IsCustomerVisible) { <span class="badge bg-success">Customer visible</span> }
                            else { <span class="badge bg-secondary">Internal</span> }
                        </span>
                        @if (User.IsInRole("Manager") || attachment.UploadedByUserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <form method="post" asp-page-handler="DeleteAttachment" asp-route-id="@Model.Ticket.Id" asp-route-attachmentId="@attachment.Id" onsubmit="return confirm('Delete this attachment?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        <p class="form-text mb-0">Files uploaded with replies appear beneath their reply. Files already attached directly to the ticket remain listed here.</p>
    </div>
</div>

<!-- Comments Section -->
<div class="card mt-4 mb-4">
    <div class="card-header">
        <h5 class="mb-0">Comments & Communication (@Model.Comments.Count)</h5>
    </div>
    <div class="card-body">
        @if (Model.Comments.Count == 0)
        {
            <p class="text-muted mb-3">No comments yet. Be the first to add a comment.</p>
        }
        else
        {
            <div class="list-group mb-4">
                @foreach (var comment in Model.Comments)
                {
                    var isAuthor = comment.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                    <div class="list-group-item">
                        @if (Model.EditingCommentId == comment.Id)
                        {
                            <form method="post" asp-page-handler="EditComment" asp-route-id="@Model.Ticket.Id">
                                <input type="hidden" asp-for="EditCommentId" value="@comment.Id" />
                                <div class="mb-2">
                                    <textarea asp-for="EditCommentText" class="form-control" rows="3">@Model.EditCommentText</textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                <a asp-page="./Details" asp-route-id="@Model.Ticket.Id" class="btn btn-secondary btn-sm">Cancel</a>
                            </form>
                        }
                        else
                        {
                            <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1">
                                        <strong>@comment.UserName</strong>
                                        <small class="text-muted ms-1">@comment.UserRole</small>
                                        @if (comment.IsInternal)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Internal</span>
                                        }
                                        @if (comment.UpdatedAt.HasValue)
                                        {
                                            <small class="text-muted ms-1">(edited)</small>
                                        }
                                    </h6>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted">@comment.CreatedAt.ToString("M/d/yyyy HH:mm")</small>
                                    @if (isAuthor)
                                    {
                                        <a asp-page="./Details" asp-route-id="@Model.Ticket.Id" asp-route-editComment="@comment.Id"
                                           class="btn btn-outline-secondary btn-sm py-0 px-1" title="Edit">Edit</a>
                                    }
                                </div>
                            </div>
                            <p class="mb-0 text-break">@comment.Comment</p>
                            @if (comment.Attachments.Count > 0)
                            {
                                <div class="mt-3">
                                    <strong class="small">Attachments</strong>
                                    <ul class="list-group list-group-flush mt-1">
                                        @foreach (var attachment in comment.Attachments.OrderBy(a => a.CreatedAt))
                                        {
                                            <li class="list-group-item px-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                <span>
                                                    <a asp-page-handler="DownloadAttachment" asp-route-id="@Model.Ticket.Id" asp-route-attachmentId="@attachment.Id">@attachment.FileName</a>
                                                    <small class="text-muted">(@((attachment.FileSize / 1024d).ToString("N0")) KB)</small>
                                                    @if (!attachment.IsCustomerVisible) { <span class="badge bg-secondary">Internal</span> }
                                                    else { <span class="badge bg-success">Customer visible</span> }
                                                </span>
                                                @if (User.IsInRole("Manager") || attachment.UploadedByUserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                                {
                                                    <form method="post" asp-page-handler="DeleteAttachment" asp-route-id="@Model.Ticket.Id" asp-route-attachmentId="@attachment.Id" onsubmit="return confirm('Delete this attachment?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }

        <hr />
        <h6>Add a Comment</h6>
        <form method="post" enctype="multipart/form-data" asp-page-handler="AddComment" asp-route-id="@Model.Ticket.Id">
            <div class="mb-3">
                <textarea asp-for="NewComment" class="form-control" rows="3"
                          placeholder="Share your thoughts or status update..." required></textarea>
                <span asp-validation-for="NewComment" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" asp-for="IsInternalComment" class="form-check-input" id="isInternal" />
                <label class="form-check-label" for="isInternal">
                    Internal note (not visible to customer)
                </label>
            </div>
            <div class="mb-3">
                <label asp-for="AttachmentFile" class="form-label">Attach a file to this reply (optional)</label>
                <input asp-for="AttachmentFile" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.txt,.log,.csv,.doc,.docx,.xlsx" />
                <div class="form-text">Maximum 10 MB. File visibility follows the reply: internal notes stay internal.</div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
        </form>
    </div>
</div>

<!-- Activity Timeline -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Activity Timeline (@Model.Activities.Count)</h5>
    </div>
    <div class="card-body">
        @if (Model.Activities.Any())
        {
            @foreach (var activity in Model.Activities)
            {
                var display = Model.ActivityDisplayMap[activity.Id];
                var formatted = display.FormattedText;
                var icon = display.Icon;
                var cssClass = display.CssClass;
                var bgClass = activity.IsInternal ? "bg-warning bg-opacity-10" : "";
                var isTimeEntry = activity.Type == ActivityType.TimeRegistered;
                var isAuthor = activity.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                <div class="d-flex mb-3 p-2 rounded @bgClass">
                    <div class="me-3 pt-1">
                        <i class="bi @icon @cssClass fs-5"></i>
                    </div>
                    <div class="flex-grow-1">
                        @if (Model.EditingActivityId == activity.Id)
                        {
                            <form method="post" asp-page-handler="EditTimeEntry" asp-route-id="@Model.Ticket.Id">
                                <input type="hidden" asp-for="EditActivityId" value="@activity.Id" />
                                <div class="row mb-2">
                                    <div class="col-4">
                                        <label class="form-label small">Hours</label>
                                        <input type="number" class="form-control form-control-sm"
                                               asp-for="EditActivityHours" min="0" max="24" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small">Minutes</label>
                                        <input type="number" class="form-control form-control-sm"
                                               asp-for="EditActivityMinutes" min="0" max="59" />
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small">Work Notes</label>
                                    <textarea asp-for="EditActivityDescription" class="form-control form-control-sm" rows="2">@Model.EditActivityDescription</textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                <a asp-page="./Details" asp-route-id="@Model.Ticket.Id" class="btn btn-secondary btn-sm">Cancel</a>
                            </form>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@activity.UserName</strong>
                                    @if (activity.IsInternal)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Internal</span>
                                    }
                                    @if (activity.UpdatedAt.HasValue)
                                    {
                                        <small class="text-muted ms-1">(edited)</small>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted text-nowrap">@activity.CreatedAt.ToString("M/d/yyyy HH:mm")</small>
                                    @if (isTimeEntry && isAuthor)
                                    {
                                        <a asp-page="./Details" asp-route-id="@Model.Ticket.Id" asp-route-editActivity="@activity.Id"
                                           class="btn btn-outline-secondary btn-sm py-0 px-1" title="Edit">Edit</a>
                                    }
                                </div>
                            </div>
                            <p class="mb-0 text-muted">@formatted</p>

                            @if (activity.TimeSpent.HasValue)
                            {
                                <small class="text-muted">
                                    Time: @((int)activity.TimeSpent.Value.TotalHours)h @(activity.TimeSpent.Value.Minutes)m
                                </small>
                            }

                            @if (!string.IsNullOrEmpty(activity.OldValue) || !string.IsNullOrEmpty(activity.NewValue))
                            {
                                <div class="small mt-1">
                                    <span class="text-danger">@activity.OldValue</span>
                                    <span class="text-muted mx-1">-></span>
                                    <span class="text-success">@activity.NewValue</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                if (activity != Model.Activities.Last())
                {
                    <hr class="my-0" />
                }
            }
        }
        else
        {
            <p class="text-muted">No activity history yet.</p>
        }
    </div>
</div>

<!-- Log Time Modal -->
<div class="modal fade" id="logTimeModal" tabindex="-1" aria-labelledby="logTimeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="LogTime" asp-route-id="@Model.Ticket.Id">
                <div class="modal-header">
                    <h5 class="modal-title" id="logTimeModalLabel">Log Time</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.ShowLogTimeError)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }
                    <div class="alert alert-info small mb-3">
                        <strong>Required:</strong> Enter time spent and describe the work performed.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Time Spent <span class="text-danger">*</span></label>
                        <div class="row">
                            <div class="col-md-6">
                                <label for="Hours" class="form-label">Hours</label>
                                <input type="number" class="form-control" asp-for="Hours" min="0" max="24" />
                            </div>
                            <div class="col-md-6">
                                <label for="Minutes" class="form-label">Minutes</label>
                                <input type="number" class="form-control" asp-for="Minutes" min="0" max="59" />
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TimeDescription" class="form-label">Work Notes <span class="text-danger">*</span></label>
                        <textarea asp-for="TimeDescription" class="form-control" rows="3"
                                  placeholder="Describe the work done (required)..." required></textarea>
                        <span asp-validation-for="TimeDescription" class="text-danger"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" asp-for="IsInternal" />
                        <label class="form-check-label" asp-for="IsInternal">
                            Internal note (not visible to customer)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Log Time</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.ShowLogTimeError)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = new bootstrap.Modal(document.getElementById('logTimeModal'));
            modal.show();
        });
    </script>
}
