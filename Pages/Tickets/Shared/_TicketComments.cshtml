@using WebApplication1.Models

@{
    var comments = Model as List<TicketComment> ?? new List<TicketComment>();
    var isAgentView = (bool?)ViewData["IsAgentView"] ?? false;
}

@if (comments.Count == 0)
{
    <div class="alert alert-info" role="alert">
        <strong>No comments yet.</strong> Be the first to add a comment.
    </div>
}
else
{
    <div class="list-group">
        @foreach (var comment in comments)
        {
            <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                    <div>
                        <h6 class="mb-1">
                            <strong>@comment.UserName</strong>
                            <span class="badge bg-secondary">@comment.UserRole</span>
                            @if (comment.IsInternal && isAgentView)
                            {
                                <span class="badge bg-warning text-dark">Internal</span>
                            }
                        </h6>
                    </div>
                    <small class="text-muted">@comment.CreatedAt.ToString("M/d/yyyy HH:mm")</small>
                </div>
                <p class="mb-0 text-break">@comment.Comment</p>
            </div>
        }
    </div>
}