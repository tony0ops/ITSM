@model List<WebApplication1.Models.Ticket>
@using WebApplication1.Models

@if (Model?.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No tickets in this category.
    </div>
}
else
{
    <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Number</th>
                <th>Title</th>
                <th>Category</th>
                <th>Severity</th>
                <th>Status</th>
                <th>Created</th>
                <th>SLA</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var item in Model)
                {
                    var now = DateTime.Now;
                    var state = SlaPolicy.GetState(item, now);
                    var remaining = SlaPolicy.FormatRemaining(item, now);

                    var isClosed = item.Status == TicketStatus.Closed ||
                                   item.Status == TicketStatus.Resolved ||
                                   item.Status == TicketStatus.Cancelled;

                    var slaBadge = state switch
                    {
                        SlaState.Green => "bg-success",
                        SlaState.Yellow => "bg-warning text-dark",
                        SlaState.Red => "bg-danger",
                        SlaState.Breached => "bg-dark",
                        _ => "bg-secondary"
                    };

                    var severityClass = item.Severity switch
                    {
                        Severity.Critical => "text-danger fw-semibold",
                        Severity.High => "text-warning fw-semibold",
                        _ => ""
                    };

                    <tr class="@(isClosed ? "table-secondary opacity-75" : "")">
                        <td><a asp-page="/Tickets/Details" asp-route-id="@item.Id"><strong>@item.Number</strong></a></td>
                        <td>@item.Title</td>
                        <td><small>@item.Category.ToString().Replace("GeneralRequest", "General")</small></td>
                        <td><small class="@severityClass">@item.Severity</small></td>
                        <td><small>@item.Status.ToString().Replace("WaitingOnCustomer", "Wait: Customer").Replace("WaitingOnVendor", "Wait: Vendor")</small></td>
                        <td><small>@item.CreatedAt.ToString("g")</small></td>
                        <td>
                            @if (isClosed)
                            {
                                <small class="text-muted">Closed</small>
                            }
                            else if (SlaPolicy.IsSlaPaused(item.Status))
                            {
                                <small class="text-info">Paused</small>
                            }
                            else
                            {
                                <small><span class="badge @slaBadge">@state - @remaining</span></small>
                            }
                        </td>
                        <td>
                            <a asp-page="/Tickets/Edit" asp-route-id="@item.Id" class="text-primary text-decoration-none">Update</a>
                            <span class="text-muted mx-1">|</span>
                            <a asp-page="/Tickets/Details" asp-route-id="@item.Id" class="text-secondary text-decoration-none">Details</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}