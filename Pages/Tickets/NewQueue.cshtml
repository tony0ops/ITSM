@page
@model WebApplication1.Pages.Tickets.NewQueueModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Unassigned Tickets";
}

<h1>Unassigned Tickets</h1>
<p class="text-muted">Tickets waiting for assignment</p>

@if (Model.Tickets.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No unassigned tickets in the queue. All tickets have been assigned.
    </div>
}
else
{
    <p class="text-muted small mb-2">@Model.Tickets.Count unassigned ticket(s)</p>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:100px;">Number</th>
                    <th style="width:250px;">Title</th>
                    <th style="width:90px;">Category</th>
                    <th style="width:80px;">Severity</th>
                    <th style="width:110px;">Group</th>
                    <th style="width:120px;">Customer</th>
                    <th style="width:110px;">Created</th>
                    <th style="width:90px;">SLA</th>
                    <th style="width:100px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Tickets)
                {
                    var now = DateTime.Now;
                    var state = SlaPolicy.GetState(item, now);
                    var remaining = SlaPolicy.FormatRemaining(item, now);
                    var slaBadge = SlaPolicy.GetBadgeClass(state);

                    var sevDot = item.Severity switch
                    {
                        Severity.Critical => "#dc3545",
                        Severity.High => "#fd7e14",
                        Severity.Medium => "#0d6efd",
                        Severity.Low => "#0dcaf0",
                        Severity.Info => "#6c757d",
                        _ => "#6c757d"
                    };

                    var sevDotStyle = $"background-color:{sevDot};";

                    <tr>
                        <td class="text-nowrap">
                            <a asp-page="./Details" asp-route-id="@item.Id"><small>@item.Number</small></a>
                        </td>
                        <td style="max-width:250px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@item.Title">
                            <small>@item.Title</small>
                        </td>
                        <td><small class="text-muted">@item.Category</small></td>
                        <td>
                            <span class="status-dot status-dot-sm me-1" style="@sevDotStyle"></span>
                            <small>@item.Severity</small>
                        </td>
                        <td><small>@(item.AssignedGroup != AssignmentGroup.Unassigned ? item.AssignedGroup.ToString().Replace("_", " ") : "-")</small></td>
                        <td style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            <small>
                                @if (item.Customer != null)
                                {
                                    @item.Customer.CompanyName
                                }
                                else
                                {

                                    <span class="text-muted">-</span>
                                }
                            </small>
                        </td>
                        <td class="text-nowrap"><small class="text-muted">@item.CreatedAt.ToString("M/d/yyyy HH:mm")</small></td>
                        <td><small><span class="badge @slaBadge">@remaining</span></small></td>
                        <td class="text-nowrap">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="text-primary text-decoration-none">Edit</a>
                            <span class="text-muted mx-1">|</span>
                            <a asp-page="./Details" asp-route-id="@item.Id" class="text-secondary text-decoration-none">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div>
    <a asp-page="./Index" class="btn btn-secondary mt-3">Back to All Tickets</a>
</div>