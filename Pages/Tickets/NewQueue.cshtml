@page
@model WebApplication1.Pages.Tickets.NewQueueModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "New Tickets Queue";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>New Tickets Queue</h1>
<p class="text-muted">Unassigned tickets waiting for assignment</p>

@if (Model.Tickets.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No new tickets in the queue. All tickets have been assigned.
    </div>
}
else
{
    <p class="text-muted small mb-2">@Model.Tickets.Count unassigned ticket(s)</p>

    <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Number</th>
                <th>Title</th>
                <th>Category</th>
                <th>Severity</th>
                <th>Created</th>
                <th>SLA</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Tickets)
            {
                var now = DateTime.Now;
                var state = SlaPolicy.GetState(item, now);
                var remaining = SlaPolicy.FormatRemaining(item, now);

                var slaBadge = state switch
                {
                    SlaState.Green => "bg-success",
                    SlaState.Yellow => "bg-warning text-dark",
                    SlaState.Red => "bg-danger",
                    SlaState.Breached => "bg-dark",
                    _ => "bg-secondary"
                };

                var severityClass = item.Severity switch
                {
                    Severity.Critical => "text-danger fw-semibold",
                    Severity.High => "text-warning fw-semibold",
                    _ => ""
                };

                <tr>
                    <td><a asp-page="./Details" asp-route-id="@item.Id"><strong>@item.Number</strong></a></td>
                    <td>@item.Title</td>
                    <td><small>@item.Category.ToString().Replace("GeneralRequest", "General")</small></td>
                    <td><small class="@severityClass">@item.Severity</small></td>
                    <td><small>@item.CreatedAt.ToString("g")</small></td>
                    <td><small><span class="badge @slaBadge">@state - @remaining</span></small></td>
                    <td class="text-nowrap">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="text-primary text-decoration-none">Assign</a>
                        <span class="text-muted mx-1">|</span>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="text-secondary text-decoration-none">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div>
    <a asp-page="./Index" class="btn btn-secondary mt-3">Back to All Tickets</a>
</div>