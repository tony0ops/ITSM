@page
@model WebApplication1.Pages.Tickets.NewQueueModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Unassigned Tickets";
}

<h1>Unassigned Tickets</h1>
<p class="text-muted">Open tickets with no individual assignee. Claim tickets routed to your team, or take an unassigned ticket and route it to your team.</p>

@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-warning">@error</div> }
@if (Model.CanClaim)
{
    <p class="small text-muted">You will claim tickets as yourself and route unassigned tickets to <strong>@Model.ClaimTeamName</strong>.</p>
}
else
{
    @if (Model.HasUnroutedTeam)
    {
        <div class="alert alert-warning">Team <strong>@Model.ClaimTeamName</strong> has no routing group. Ask a Manager to assign a support group before claiming tickets.</div>
    }
    else if (User.IsInRole("Manager"))
    {
        <div class="alert alert-info">Assign your account to an active team from Users before claiming team work.</div>
    }
    else
    {
        <div class="alert alert-info">Ask a Manager to assign your account to an active team before claiming tickets.</div>
    }
}

@if (Model.Tickets.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No unassigned tickets in the queue. All tickets have been assigned.
    </div>
}
else
{
    <p class="text-muted small mb-2">@Model.Pagination.TotalCount unassigned ticket(s)</p>

    <form method="post" asp-page-handler="ClaimSelected">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    @if (Model.CanClaim) { <th>Select</th> }
                    <th style="width:100px;">Number</th>
                    <th style="width:250px;">Title</th>
                    <th style="width:90px;">Category</th>
                    <th style="width:80px;">Severity</th>
                    <th style="width:110px;">Group</th>
                    <th style="width:120px;">Customer</th>
                    <th style="width:110px;">Created</th>
                    <th style="width:90px;">SLA</th>
                    <th style="width:100px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Tickets)
                {
                    var now         = DateTime.Now;
                    var state       = SlaPolicy.GetState(item, now);
                    var remaining   = SlaPolicy.FormatRemaining(item, now);
                    var slaBadge    = SlaPolicy.GetBadgeClass(state);
                    var sevDotStyle = $"background-color:{TicketHelper.GetSeverityDotColor(item.Severity)};";

                    <tr>
                        @if (Model.CanClaim && (item.AssignedGroup == AssignmentGroup.Unassigned || item.AssignedGroup == Model.ClaimGroup))
                        {
                            <td><input type="checkbox" name="SelectedTicketIds" value="@item.Id" aria-label="Select @item.Number to claim" /></td>
                        }
                        else if (Model.CanClaim)
                        {
                            <td><span class="text-muted" title="Routed to another team">—</span></td>
                        }
                        <td class="text-nowrap">
                            <a asp-page="./Details" asp-route-id="@item.Id"><small>@item.Number</small></a>
                        </td>
                        <td style="max-width:250px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                            title="@item.Title">
                            <small>@item.Title</small>
                        </td>
                        <td><small class="text-muted">@item.Category</small></td>
                        <td>
                            <span class="status-dot status-dot-sm me-1" style="@sevDotStyle"></span>
                            <small>@item.Severity</small>
                        </td>
                        <td>
                            <small>@(item.AssignedGroup != AssignmentGroup.Unassigned ? item.AssignedGroup.ToString().Replace("_", " ") : "-")</small>
                        </td>
                        <td style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            <small>
                                @if (item.Customer != null)
                                {
                                    @item.Customer.CompanyName
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </small>
                        </td>
                        <td class="text-nowrap">
                            <small class="text-muted">@item.CreatedAt.ToString("M/d/yyyy HH:mm")</small>
                        </td>
                        <td><small><span class="badge @slaBadge">@remaining</span></small></td>
                        <td class="text-nowrap">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="text-primary text-decoration-none">Edit</a>
                            <span class="text-muted mx-1">|</span>
                            <a asp-page="./Details" asp-route-id="@item.Id" class="text-secondary text-decoration-none">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.CanClaim)
    {
        <button type="submit" class="btn btn-success mt-2" onclick="return confirm('Claim the selected tickets for yourself?');">Claim selected for me</button>
    }
    </form>
}

<partial name="_Pagination" model="Model.Pagination" />

<div>
    <a asp-page="./Index" class="btn btn-secondary mt-3">Back to All Tickets</a>
</div>
