@page
@model WebApplication1.Pages.Tickets.EditModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Edit Ticket";
}

<h1>Edit Ticket <small class="text-muted">- @Model.Ticket.Number</small></h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Ticket.Id" />

            <div class="mb-3">
                <label asp-for="Ticket.Title" class="form-label"></label>
                <input asp-for="Ticket.Title" class="form-control" />
                <span asp-validation-for="Ticket.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.Description" class="form-label"></label>
                <textarea asp-for="Ticket.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Ticket.Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Ticket.Severity" class="form-label"></label>
                    <select asp-for="Ticket.Severity" class="form-select"
                            asp-items="Html.GetEnumSelectList<Severity>()"></select>
                    <span asp-validation-for="Ticket.Severity" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Ticket.Category" class="form-label"></label>
                    <select asp-for="Ticket.Category" class="form-select"
                            asp-items="Html.GetEnumSelectList<TicketCategory>()"></select>
                    <span asp-validation-for="Ticket.Category" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Ticket.Status" class="form-label"></label>
                    <select asp-for="Ticket.Status" class="form-select" id="statusDropdown"
                            asp-items="Html.GetEnumSelectList<TicketStatus>()"></select>
                    <span asp-validation-for="Ticket.Status" class="text-danger"></span>
                    <div class="form-text">
                        <strong>WaitingOnCustomer</strong> or <strong>WaitingOnVendor</strong> will pause SLA timer
                    </div>
                </div>
            </div>

            <div class="mb-3" id="pauseReasonGroup" style="display:none;">
                <label asp-for="Ticket.PauseReason" class="form-label">Pause Reason</label>
                <input asp-for="Ticket.PauseReason" class="form-control" placeholder="Why is the SLA being paused?" />
                <span asp-validation-for="Ticket.PauseReason" class="text-danger"></span>
            </div>

            <div class="mb-3" id="resolutionNotesGroup" style="display:none;">
                <label asp-for="Ticket.ResolutionNotes" class="form-label">Resolution Notes</label>
                <textarea asp-for="Ticket.ResolutionNotes" class="form-control" rows="3"
                          placeholder="Describe how this was resolved or why it was cancelled"></textarea>
                <span asp-validation-for="Ticket.ResolutionNotes" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.CustomerId" class="form-label">Customer</label>
                <select asp-for="Ticket.CustomerId" class="form-select" asp-items="Model.CustomerList">
                    <option value="">-- Select Customer (Optional) --</option>
                </select>
                <span asp-validation-for="Ticket.CustomerId" class="text-danger"></span>
                @if (User.IsInRole("Manager"))
                {
                    <div class="form-text">
                        <a asp-page="/Customers/Create" target="_blank">+ Add New Customer</a>
                    </div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.AssignedGroup" class="form-label">Assignment Group</label>
                <select asp-for="Ticket.AssignedGroup" class="form-select"
                        asp-items="Html.GetEnumSelectList<AssignmentGroup>()"></select>
                <span asp-validation-for="Ticket.AssignedGroup" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.AssigneeUserId" class="form-label">Assign To User (Optional)</label>
                <select asp-for="Ticket.AssigneeUserId" class="form-select" asp-items="Model.AssigneeList">
                    <option value="">-- Unassigned --</option>
                </select>
                <span asp-validation-for="Ticket.AssigneeUserId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ticket.SlaDueAt" class="form-label">Deadline</label>
                <input asp-for="Ticket.SlaDueAt"
                       type="datetime-local"
                       class="form-control"
                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                       step="60" />
                <div class="form-text">Clear the field and Save to auto-calculate again from Severity.</div>
                <span asp-validation-for="Ticket.SlaDueAt" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="./Details" asp-route-id="@Model.Ticket.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var statusDropdown = document.getElementById('statusDropdown');
            var pauseReasonGroup = document.getElementById('pauseReasonGroup');
            var resolutionNotesGroup = document.getElementById('resolutionNotesGroup');

            var pauseStatuses = ['WaitingOnCustomer', 'WaitingOnVendor'];
            var closedStatuses = ['Resolved', 'Closed', 'Cancelled'];

            function updateFields() {
                var selectedStatus = statusDropdown.value;

                // Show/hide pause reason
                if (pauseStatuses.indexOf(selectedStatus) !== -1) {
                    pauseReasonGroup.style.display = 'block';
                } else {
                    pauseReasonGroup.style.display = 'none';
                }

                // Show/hide resolution notes
                if (closedStatuses.indexOf(selectedStatus) !== -1) {
                    resolutionNotesGroup.style.display = 'block';
                } else {
                    resolutionNotesGroup.style.display = 'none';
                }
            }

            // Run on load to set initial state
            updateFields();

            // Run on change
            statusDropdown.addEventListener('change', updateFields);
        });
    </script>
}