@page
@model WebApplication1.Pages.Tickets.IndexModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Tickets";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Tickets</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control" name="q" value="@Model.Q" placeholder="Search title/description/customer..." />
    </div>

    <div class="col-md-2">
        <select class="form-select" name="status">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<WebApplication1.Models.TicketStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <select class="form-select" name="severity">
            <option value="">All severities</option>
            @foreach (var s in Enum.GetValues<WebApplication1.Models.Severity>())
            {
                <option value="@s" selected="@(Model.Severity == s)">@s</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <select class="form-select" name="category">
            <option value="">All Categories</option>
            @foreach (var c in Enum.GetValues<TicketCategory>())
            {
                <option value="@c" selected="@(Model.Category == c)">@c.ToString().Replace("GeneralRequest", "General")</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <select class="form-select" name="group">
            <option value="">All Groups</option>
            @foreach (var g in Enum.GetValues<AssignmentGroup>())
            {
                <option value="@g" selected="@(Model.Group == g)">@g.ToString().Replace("_", " ")</option>
            }
        </select>
    </div>
</form>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <select class="form-select" name="sla">
            <option value="">All SLA</option>
            <option value="atrisk" selected="@(Model.Sla == "atrisk")">At risk</option>
            <option value="green" selected="@(Model.Sla == "green")">Green</option>
            <option value="yellow" selected="@(Model.Sla == "yellow")">Yellow</option>
            <option value="red" selected="@(Model.Sla == "red")">Red</option>
            <option value="breached" selected="@(Model.Sla == "breached")">Breached</option>
        </select>
    </div>

    <div class="col-md-1">
        <button class="btn btn-primary w-100" type="submit">Filter</button>
    </div>
</form>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Number</th>
            <th>Title</th>
            <th>Category</th>
            <th>Severity</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Customer</th>
            <th>Created</th>
            <th>SLA</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Ticket)
        {
            var now = DateTime.Now;
            var state = SlaPolicy.GetState(item, now);
            var remaining = SlaPolicy.FormatRemaining(item, now);

            var badgeClass = state switch
            {
                SlaState.Green => "bg-success",
                SlaState.Yellow => "bg-warning text-dark",
                SlaState.Red => "bg-danger",
                SlaState.Breached => "bg-danger",
                _ => "bg-secondary"
            };
            
            // Severity badge color
            var severityBadge = item.Severity switch
            {
                Severity.Critical => "bg-danger",
                Severity.High => "bg-warning text-dark",
                Severity.Medium => "bg-primary",
                Severity.Low => "bg-info text-dark",
                Severity.Info => "bg-secondary",
                _ => "bg-secondary"
            };
            
            // Status badge color
            var statusBadge = item.Status switch
            {
                TicketStatus.New => "bg-primary",
                TicketStatus.Assigned => "bg-info text-dark",
                TicketStatus.InProgress => "bg-warning text-dark",
                TicketStatus.WaitingOnCustomer => "bg-secondary",
                TicketStatus.WaitingOnVendor => "bg-secondary",
                TicketStatus.Resolved => "bg-success",
                TicketStatus.Closed => "bg-dark",
                TicketStatus.Cancelled => "bg-danger",
                _ => "bg-light text-dark"
            };
            
            <tr>
                <td>@item.Number</td>
                <td>
                    <a asp-page="./Details" asp-route-id="@item.Id">@item.Title</a>
                </td>
                <td>
                    <span class="badge bg-secondary">
                        @item.Category.ToString().Replace("GeneralRequest", "General")
                    </span>
                </td>
                <td>
                    <span class="badge @severityBadge">
                        @item.Severity
                    </span>
                </td>
                <td>
                    <span class="badge @statusBadge">
                        @if (item.Status == TicketStatus.WaitingOnCustomer || item.Status == TicketStatus.WaitingOnVendor)
                        {
                            <text>⏸️ </text>
                        }
                        @item.Status.ToString().Replace("WaitingOn", "Waiting on ")
                    </span>
                </td>
                <td>
                    @if (item.AssignedGroup != AssignmentGroup.Unassigned)
                    {
                        <span class="badge bg-dark">@item.AssignedGroup.ToString().Replace("_", " ")</span>
                    }
                    else
                    {
                        <span class="text-muted">Unassigned</span>
                    }
                </td>
                <td>@item.CreatedAt.ToString("g")</td>
                <td>
                    @if (SlaPolicy.IsSlaPaused(item.Status))
                    {
                        <span class="badge bg-info">⏸️ Paused</span>
                    }
                    else
                    {
                        <span class="badge @badgeClass">
                            @state - @remaining
                        </span>
                    }
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info ms-1">Details</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
