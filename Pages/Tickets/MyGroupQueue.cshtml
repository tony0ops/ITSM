@page
@model WebApplication1.Pages.Tickets.MyGroupQueueModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "My Group's Tickets";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1> My Group's Tickets</h1>
<p class="lead">Tickets assigned to @Model.GroupName</p>

@if (Model.Tickets.Count == 0)
{
    <div class="alert alert-info" role="alert">
        <strong>All caught up!</strong> No tickets currently assigned to your group.
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <h6 class="card-title">Total Tickets</h6>
                            <p class="h4"><span class="badge bg-primary">@Model.Tickets.Count</span></p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="card-title">At Risk</h6>
                            <p class="h4"><span class="badge bg-warning text-dark">@Model.AtRiskCount</span></p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="card-title">Breached</h6>
                            <p class="h4"><span class="badge bg-danger">@Model.BreachedCount</span></p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="card-title">In Progress</h6>
                            <p class="h4"><span class="badge bg-info">@Model.InProgressCount</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab">All (@Model.Tickets.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="atrisk-tab" data-bs-toggle="tab" data-bs-target="#atrisk" type="button" role="tab">At Risk (@Model.AtRiskCount)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="breached-tab" data-bs-toggle="tab" data-bs-target="#breached" type="button" role="tab">Breached (@Model.BreachedCount)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="inprogress-tab" data-bs-toggle="tab" data-bs-target="#inprogress" type="button" role="tab">In Progress (@Model.InProgressCount)</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="all" role="tabpanel">
            @await Html.PartialAsync("_TicketTable", Model.Tickets)
        </div>
        <div class="tab-pane fade" id="atrisk" role="tabpanel">
            @await Html.PartialAsync("_TicketTable", Model.GetAtRiskTickets())
        </div>
        <div class="tab-pane fade" id="breached" role="tabpanel">
            @await Html.PartialAsync("_TicketTable", Model.GetBreachedTickets())
        </div>
        <div class="tab-pane fade" id="inprogress" role="tabpanel">
            @await Html.PartialAsync("_TicketTable", Model.GetInProgressTickets())
        </div>
    </div>
}

<div>
    <a asp-page="./Index" class="btn btn-secondary mt-3">Back to All Tickets</a>
</div>