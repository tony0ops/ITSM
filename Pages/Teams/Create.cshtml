@page
@model WebApplication1.Pages.Teams.CreateModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Create Team";
}

<h1>Create Team</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Team.Name" class="form-label"></label>
                <input asp-for="Team.Name" class="form-control" />
                <span asp-validation-for="Team.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Team.Description" class="form-label"></label>
                <textarea asp-for="Team.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Team.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Team.Group" class="form-label">Default Assignment Group</label>
                <select asp-for="Team.Group" class="form-select">
                    @foreach (var group in Enum.GetValues<AssignmentGroup>().Where(group => group != AssignmentGroup.Unassigned))
                    {
                        <option value="@group">@group.ToString().Replace("_", " ")</option>
                    }
                </select>
                <span asp-validation-for="Team.Group" class="text-danger"></span>
                <div class="form-text">Active teams with the same group share its ticket queue and assignee pool.</div>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" asp-for="Team.IsActive" class="form-check-input" checked />
                <label class="form-check-label" asp-for="Team.IsActive">Active</label>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create Team</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <div class="alert alert-info">
            <h6>How Teams Work</h6>
            <ul class="mb-0">
                <li><strong>Team</strong> = a group of support agents (e.g., "ServiceDesk L1")</li>
                <li><strong>Assignment Group</strong> = the ticket routing queue this team handles</li>
                <li><strong>Role</strong> (Manager/Agent) = permissions, managed separately on the Users page</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
