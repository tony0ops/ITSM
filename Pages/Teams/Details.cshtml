@page "{id:int}"
@model WebApplication1.Pages.Teams.DetailsModel

@{
    ViewData["Title"] = $"Team: {Model.Team.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Team.Name</h1>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.Team.Id" class="btn btn-primary">Edit Team</a>
        <a asp-page="./Index" class="btn btn-secondary">Back to Teams</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Assignment Group</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.Team.Group.ToString().Replace("_", " ")</span></dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Team.Description) ? "-" : Model.Team.Description)</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Team.IsActive)
                { <span class="badge bg-success">Active</span> }
                else
                { <span class="badge bg-secondary">Inactive</span> }
            </dd>
        </dl>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Current Members (@Model.Members.Count)</h5>
            </div>
            <div class="card-body">
                @if (Model.Members.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td>@member.DisplayName</td>
                                    <td><small>@member.User.Email</small></td>
                                    <td>
                                        <form method="post" asp-page-handler="RemoveMember" class="d-inline">
                                            <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                            <input type="hidden" name="userId" value="@member.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Remove @member.DisplayName from team?')">
                                                Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No members in this team yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Add Members</h5>
            </div>
            <div class="card-body">
                @if (Model.AvailableUsers.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <tr>
                                    <td>@user.DisplayName</td>
                                    <td><small>@user.User.Email</small></td>
                                    <td>
                                        <form method="post" asp-page-handler="AddMember" class="d-inline">
                                            <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Add</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">All active users are already assigned to teams.</p>
                }
            </div>
        </div>

        <div class="alert alert-info">
            <h6>How Teams Work</h6>
            <ul class="mb-0">
                <li><strong>Team</strong> = a group of support agents (e.g., "ServiceDesk L1")</li>
                <li><strong>Assignment Group</strong> = the ticket routing queue this team handles</li>
                <li><strong>Role</strong> (Manager/Agent) = permissions, managed separately on the Users page</li>
            </ul>
        </div>
    </div>
</div>