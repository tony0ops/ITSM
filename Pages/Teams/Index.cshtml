@page
@model WebApplication1.Pages.Teams.IndexModel
@using WebApplication1.Models

@{
    ViewData["Title"] = "Teams";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Teams</h1>
    @if (User.IsInRole("Manager"))
    {
        <a asp-page="./Create" class="btn btn-primary">Create Team</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Teams.Any())
{
    <div class="alert alert-info">
        No teams found.
        @if (User.IsInRole("Manager"))
        {
            @:Create a team to start assigning users.
        }
    </div>
}
else
{
    <p class="text-muted small mb-2">Showing @Model.Teams.Count team(s)</p>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Team Name</th>
                    <th>Description</th>
                    <th>Assignment Group</th>
                    <th>Members</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in Model.Teams)
                {
                    var statusDotStyle = $"background-color:{(team.IsActive ? "#198754" : "#6c757d")};";
                    var statusText     = team.IsActive ? "Active" : "Inactive";
                    var memberCount    = team.Members.Count(m => m.IsActive);

                    <tr class="@(!team.IsActive ? "table-secondary opacity-75" : "")">
                        <td>
                            @if (User.IsInRole("Manager"))
                            {
                                <a asp-page="./Details" asp-route-id="@team.Id" class="fw-semibold text-decoration-none">
                                    @team.Name
                                </a>
                            }
                            else
                            {
                                <span class="fw-semibold">@team.Name</span>
                            }
                        </td>
                        <td style="max-width:250px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                            title="@team.Description">
                            <small class="text-muted">@(string.IsNullOrEmpty(team.Description) ? "-" : team.Description)</small>
                        </td>
                        <td><small>@team.Group.ToString().Replace("_", " ")</small></td>
                        <td><small class="fw-semibold">@memberCount</small></td>
                        <td>
                            <span class="status-dot status-dot-sm me-1" style="@statusDotStyle"></span>
                            <small>@statusText</small>
                        </td>
                        <td class="text-nowrap">
                            @if (User.IsInRole("Manager"))
                            {
                                <a asp-page="./Edit" asp-route-id="@team.Id" class="text-primary text-decoration-none">Edit</a>
                                <span class="text-muted mx-1">|</span>
                                <a asp-page="./Delete" asp-route-id="@team.Id" class="text-danger text-decoration-none">Delete</a>
                                <span class="text-muted mx-1">|</span>
                                <a asp-page="./Details" asp-route-id="@team.Id" class="text-secondary text-decoration-none">Members</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}